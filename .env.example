# Copy this file to ".env" and fill in only what you need.
# Every value is optional: without keys the system still collects, extracts and indexes.

# --- Claude (AI reasoning). Get a key at https://console.anthropic.com ---
ANTHROPIC_API_KEY=
# TH_AI_MODEL=claude-opus-5-5
# TH_AI_DAILY_CALL_LIMIT=200
# TH_AI_DAILY_BUDGET_USD=2.00

# --- Optional semantic search embeddings (Voyage AI, has a free tier) ---
VOYAGE_API_KEY=

# --- Optional collectors (each stays disabled until its key is set) ---
YOUTUBE_API_KEY=
CORE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
X_BEARER_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Contact e-mail sent to OpenAlex / Crossref "polite pool" (recommended)
TH_CONTACT_EMAIL=

# Where data lives (database, files). Default: ./data
# TH_DATA_DIR=./data
